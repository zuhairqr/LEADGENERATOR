        260
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://gmail.googleapis.com/gmail/v1/users/me/messages?maxResults=5&q='+encodeURIComponent($json.q)+($json.pageToken?'&pageToken='+encodeURIComponent($json.pageToken):'') }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
