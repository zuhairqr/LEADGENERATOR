    {
      "id": "Return matched metadata",
      "name": "Return matched metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1050,
        260
      ],
      "parameters": {
        "jsCode": "const messages=[];for(const item of $input.all()){const v=item.json,h={};for(const x of v.payload?.headers||[])h[x.name.toLowerCase()]=x.value;const sender=(h.from||'').match(/(?:<|^)([^<>\\s]+@[^<>\\s]+)>?/)?.[1]?.toLowerCase();const references=((h['in-reply-to']||'')+' '+(h.references||'')).match(/[^<>\\s]+@[^<>\\s]+/g)||[];if(v.threadId)references.push(v.threadId);if(!sender||!references.length)continue;messages.push({sender,references:[...new Set(references)].slice(0,30),provider_message_id:v.id,subject:h.subject||'',snippet:v.snippet||'',outcome:h['x-failed-recipients']?'bounce':'reply',failed_recipient:h['x-failed-recipients']||null});}return [{json:{ok:true,messages,nextPageToken:$('List tracked replies').first().json.nextPageToken||null}}];"
      }
    },
