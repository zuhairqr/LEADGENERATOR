            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate AI response": {
      "main": [
        [
          {
            "node": "Return safe result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
