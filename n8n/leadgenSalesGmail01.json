    {
      "id": "Build exact approved MIME",
      "name": "Build exact approved MIME",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        260
      ],
      "parameters": {
        "jsCode": "const buildApprovedMime=function buildApprovedMime(b,profile) {\n if(String(profile.emailAddress).toLowerCase()!==String(b.fromEmail).toLowerCase()) throw Error('Sender does not match connected Gmail account');\n if(!/^[0-9a-f-]{36}$/.test(b.messageId)||/[\\r\\n]/.test(b.recipient+b.subject+b.fromEmail+(b.fromName||''))||!b.recipient||!b.subject||!b.body)throw Error('Invalid approved message');\n const rfc=b.messageId+'@'+b.fromEmail.split('@')[1];\n const from=b.fromName?'=?UTF-8?B?'+Buffer.from(b.fromName).toString('base64')+'?= <'+b.fromEmail+'>':b.fromEmail;\n const headers=['From: '+from,'To: '+b.recipient,'Subject: =?UTF-8?B?'+Buffer.from(b.subject).toString('base64')+'?=','Message-ID: <'+rfc+'>','MIME-Version: 1.0','Content-Type: text/plain; charset=UTF-8','Content-Transfer-Encoding: base64'];\n if(b.parentMessageId && !/[\\r\\n]/.test(b.parentMessageId))headers.push('In-Reply-To: <'+b.parentMessageId.replace(/[<>]/g,'')+'>','References: <'+b.parentMessageId.replace(/[<>]/g,'')+'>');\n const text=Buffer.from(b.body).toString('base64').match(/.{1,76}/g).join('\\r\\n');\n return {raw:Buffer.from(headers.join('\\r\\n')+'\\r\\n\\r\\n'+text).toString('base64url'),rfc};\n}; return [{json:buildApprovedMime($(\"Claim approved server envelope\").first().json,$json)}];"
      }
    },
