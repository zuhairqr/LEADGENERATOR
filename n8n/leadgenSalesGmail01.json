      "name": "Gmail receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        260
      ],
      "parameters": {
        "jsCode": "const gmailDeliveryReceipt=function gmailDeliveryReceipt(sent, metadata) {\n if (typeof sent?.id !== 'string' || !sent.id) throw Error('Gmail result missing');\n const headers = metadata?.id === sent.id && Array.isArray(metadata?.payload?.headers) ? metadata.payload.headers : [];\n const header = headers.find(h => h.name?.toLowerCase() === 'message-id')?.value;\n const messageId = typeof header === 'string' ? header.trim().match(/^<([^<>\\s@]+@[^<>\\s@]+)>$/)?.[1] : null;\n return {ok:true, message_id:messageId || null, thread_id:sent.threadId || null};\n}; return [{json:gmailDeliveryReceipt($('Send approved email').first().json,$input.first().json)}];"
      }
